<!DOCTYPE html>
<html>
  <head>
    <title>BreweryApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body>
    <!-- Simple Navigation Menu -->
    <header style="padding: 1rem; background-color: #f4f4f4; margin-bottom: 1rem;">
      <nav>
        <strong>Brewery Directory</strong> | 
        <%= link_to "About", root_path %> | 
        <%= link_to "States", states_path %> | 
        <%= link_to "Breweries", breweries_path %>
      </nav>
    </header>

    <div style="padding: 0 1rem;">
      <%= yield %>
    </div>
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
  <div class="container">
    <a class="navbar-brand" href="/">Brewery App</a>
    <div class="navbar-nav">
      <a class="nav-link" href="/">Home / About</a>
      <!-- We will add States and Breweries links here soon -->
    </div>
  </div>
</nav>
  </body>
</html>