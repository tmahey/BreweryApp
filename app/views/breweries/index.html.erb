<h1>All Breweries</h1>
<%= form_with url: breweries_path, method: :get do %>
  <div>
    <%= text_field_tag :search, params[:search], placeholder: "Search brewery name..." %>

    <%= select_tag :state_id, options_from_collection_for_select(State.all, :id, :name, params[:state_id]), include_blank: "All States" %>

    <%= submit_tag "Filter" %>
    <%= link_to "Reset", breweries_path %>
  </div>
<% end %>
<table border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th>Name</th>
      <th>Type</th>
      <th>City</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @breweries.each do |brewery| %>
      <tr>
        <td><%= brewery.name %></td>
        <td><%= brewery.brewery_type %></td>
        <td><%= brewery.city %></td>
        <td>
          <%= link_to "Show Details", brewery_path(brewery) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @breweries %>